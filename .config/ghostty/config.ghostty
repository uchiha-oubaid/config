# Ghostty Configuration
# Generated by Ventz's Ghostty Settings Generator
# https://github.com/ventz/ghostty-settings-visual-config

# Font family to use
# Options: String: font name
font-family = JetBrainsMonoNL NFM Medium

# Font size in points
# Options: Number
font-size = 19

# Synthesize bold/italic if unavailable
# Options: true, false, no-bold, no-italic
font-synthetic-style = true

# Color theme name or path
# Options: String
theme = Gruber Darker

# Cursor style
# Options: block, bar, underline, block_hollow
cursor-style = block

# Cursor blink
# Options: Boolean
cursor-style-blink = false

# Window decorations
# Options: auto, none, client, server
window-decoration = server

window-width = 1280
window-height = 720

# Window theme
# Options: auto, system, light, dark
window-theme = system

# Enable VSync
# Options: Boolean
window-vsync = true

# Confirm before closing
# Options: Boolean
confirm-close-surface = true

# Allow clipboard read
# Options: ask, allow, deny
clipboard-read = allow

# Allow clipboard write
# Options: ask, allow, deny
clipboard-write = allow

# Copy on selection
# Options: Boolean
copy-on-select = false

# Trim spaces when copying
# Options: Boolean
clipboard-trim-trailing-spaces = true

# Paste protection warning
# Options: Boolean
clipboard-paste-protection = true

# Safe bracketed paste
# Options: Boolean
clipboard-paste-bracketed-safe = true

# Shell integration
# Options: detect, none, bash, fish, zsh
shell-integration = none

# Allow desktop notifications
# Options: Boolean
desktop-notifications = true

# Enable window shadow
# Options: Boolean
macos-window-shadow = true

# Auto secure keyboard input
# Options: Boolean
macos-auto-secure-input = true

# Show secure input indicator
# Options: Boolean
macos-secure-input-indication = true

# Quick terminal position
# Options: top, bottom, left, right, center
quick-terminal-position = center

# Auto-hide on focus lost
# Options: Boolean
quick-terminal-autohide = true
